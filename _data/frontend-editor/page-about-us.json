    "tnb0dad59": "In-House Tech Experts",
    "tc1ad": "20+",
    "t39aa538": "Years of IT staffing",
    "t297e733c": "We deliver tailored, future-ready solutions that drive efficiency and growth.",
    "tn7468bdb7": "Deep Domain Expertise",
    "tn55a8c832": "We combine industry knowledge and innovation to deliver meaningful business outcomes.",
    "tn7ac10c4d": "Unwavering Commitment",
